{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Information",
      "Microsoft": "Warning"
    },
    "Console": {
      "FormatterName": "simple"
    }
  },
  "AllowedHosts": "*",
  "JigenServer": {
    "Https": {
      "Mode": "None",
      "CertificatePath": "",
      "CertificatePassword": ""
    }
  },
  "JigenEmbeddings": {
    "TokenizerPath": "/data/onnx/nomic-embed-text-v1.5/tokenizer.onnx",
    "EmbeddingsModelPath": "/data/onnx/nomic-embed-text-v1.5/model_int8.onnx",
    "GeneratorOptions": {
      "Profile": "Nomic",
      "MaxTokens": 2048,
      "UseChunking": true,
      "ChunkSize": 1536,
      "ChunkOverlap": 192,
      "HeadTailHeadTokens": 256,
      "IntraOpNumThreads": 10,
      "MaxBatchSize": 1,
      "OutputDimension": 768,
      "PaddingTokenId": 0,
      "ExecutionProvider": "cpu"
    },
    "PassageSplitting": {
      "DefaultTokenSize": 512,
      "DefaultOverlapSize": 64,
      "MaxTokenSize": 1024,
      "MaxOverlapSize": 192
    },
    "EmbeddingsMaxConcurrency": 2,
    "EmbeddingsQueueCapacity": 64,
    "EmbeddingsQueueTimeoutSeconds": 60,
    "DefaultTask": "search_document",
    "Tasks": [
      "search_document",
      "search_query",
      "clustering",
      "classification"
    ],
    "ImagesModelPath": "",
    "ImageEmbeddingsMaxConcurrency": 1,
    "ImageEmbeddingsQueueCapacity": 10,
    "ImageEmbeddingsQueueTimeoutSeconds": 60
  },
  "Kaido": {
    "Enabled": true
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "ExchangeName": "JigenExchange",
    "UserName": "jigen",
    "Password": "P@ssw0rd",
    "VirtualHost": "Jigen",
    "PerChannelQos": 10,
    "PerConsumerQos": 10
  }
}